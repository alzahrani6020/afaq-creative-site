# Local secrets and environment files
.env
.env.*
!.env.example

# Admin/local credentials
.admin_credentials
.admin_reset_password
**/.admin_credentials
**/.admin_reset_password

# Local/private runtime state
var/private-owner/
var/saudi-saas-private/

# Local databases and database backups
*.db
*.db.*
**/*.db
**/*.db.*

# Backups, dumps, and temporary artifacts
backups/
**/backups/
*.bak
*.dump
*.sql
*.sqlite
*.sqlite3

# Local caches and generated artifacts not required for deployment
node_modules/
.next/
coverage/
*.log

# Editor / OS noise
.DS_Store
Thumbs.db
